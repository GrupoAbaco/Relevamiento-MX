    else if (b.type === 'matrix') b.rows.forEach(r => b.cols.forEach(c => { const t = r.t && c.k in r.t ? r.t[c.k] : c.t; if (t === null) return; mk(s, b, [b.key, r.k, c.k], {...c, t}, `${r.l} — ${c.l}`, null); }));
    if (b.obs) mk(s, b, [b.key, 'observaciones'], {t:'ta'}, 'Observaciones', null);
  }));
  return _cat = out;
}
