  },
  async updateAttachment(id, detail) { this.chk(await this.sb.from('attachments').update({detail}).eq('id', id)); },
  async deleteAttachment(a) { await this.sb.storage.from('attachments').remove([a.file_path]); this.chk(await this.sb.from('attachments').delete().eq('id', a.id)); },
