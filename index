const OPS = {es:'es', nes:'no es', contiene:'contiene', eq:'=', gt:'>', gte:'≥', lt:'<', lte:'≤', between:'entre', filled:'tiene dato'};
function opsFor(f) { return f.t === 'yn' || f.t === 'sel' ? ['es', 'nes', 'filled'] : f.t === 'n' ? ['gte', 'lte', 'gt', 'lt', 'eq', 'between', 'filled'] : f.t === 'd' ? ['gt', 'lt', 'eq', 'filled'] : ['contiene', 'es', 'filled']; }

function cellState(c, r) {
  const tipo = tipoOf(r.e), obra = obraOf(r.e), d = c.scope === 'h' ? r.h.data : r.e.data;
  if (c.scope !== 'h' && (!okWhen(c.b.when, tipo) || bNA(c.b, obra))) return {st:'na'};
  if (c.src && !fVis(c.src, tipo, obra, d, c.b)) return {st:'na'};
  const v = getP(d, c.path); return empty(v) ? {st:'nd'} : {st:'v', v};
}
function evalCond(cd, r) {
  const c = catById(cd.field); if (!c) return {res:null, st:'na'};
  const s = cellState(c, r); if (s.st === 'na') return {res:null, st:'na'};
  if (cd.op === 'filled') return {res:s.st === 'v', st:s.st, v:s.v};
  if (s.st === 'nd') return {res:null, st:'nd'};
  const v = s.v, t = c.f.t; let res;
  if (t === 'n') { const x = Number(v), a = Number(cd.v), b2 = Number(cd.v2);
    res = cd.op === 'gte' ? x >= a : cd.op === 'lte' ? x <= a : cd.op === 'gt' ? x > a : cd.op === 'lt' ? x < a : cd.op === 'eq' ? x === a : cd.op === 'between' ? (x >= Math.min(a, b2) && x <= Math.max(a, b2)) : false;
    if ((cd.op !== 'between' && cd.v === '') || (cd.op === 'between' && (cd.v === '' || cd.v2 === ''))) res = null; }
