    rows = pop.filter(x => x.ok).map(x => [...hcell(x.r.h), {t:tipoOf(x.r.e)}, {t:obraOf(x.r.e)}, {t:x.r.e.status === 'completed' ? 'Final' : 'Parcial'},
      ...x.rs.map((y, i) => ({t:mark(y) + (y.st === 'v' && q.conds[i].op !== 'filled' ? ' (' + y.v + ')' : ''), c:cls(y)})),
