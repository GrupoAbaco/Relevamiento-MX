CONFIG.SUPABASE_URL = (CONFIG.SUPABASE_URL || '').trim(); CONFIG.SUPABASE_ANON_KEY = (CONFIG.SUPABASE_ANON_KEY || '').trim();
let DB = (CONFIG.SUPABASE_URL && CONFIG.SUPABASE_ANON_KEY) ? Sb : Local;

/* ============ LÓGICA DE ESQUEMA ============ */
const tipoOf = e => e?.data?.provision?.tipo_equipo || '';
const okWhen = (w, tipo) => !w || w.includes(tipo);
const obraOf = e => e?.data?.provision?.provision_obra || '';
const bNA = (b, obra) => !!(b.noObra && b.noObra.includes(obra));
const fVis = (f, tipo, obra, d, b) => okWhen(f.when, tipo) && !(f.noObra && f.noObra.includes(obra)) && (!f.showIf || getP(d, [b.key, f.showIf.k]) === f.showIf.eq);
function normEq(e) { const d = e.data = e.data || {}; let ch = false; const pv = d.provision;
  if (pv) { const mE = {Nuevo:'Nueva incorporación', Reemplazo:'Sustitución'}, mO = {Reemplazo:'Sustitución', Refuncionalizacion:'Refuncionalización'};
    if (mE[pv.provision_equipo]) { pv.provision_equipo = mE[pv.provision_equipo]; ch = true; }
    if (mO[pv.provision_obra]) { pv.provision_obra = mO[pv.provision_obra]; ch = true; } }
  const cc = d.contactos_centro; if (cc && cc.recurso_fisico && !cc.referente) { cc.referente = {...cc.recurso_fisico}; ch = true; }
  if (cc && cc.referente && cc.referente.nombres && !cc.referente.nombre) { cc.referente.nombre = cc.referente.nombres; ch = true; }
  return ch; }
const visSections = tipo => SECTIONS.filter(s => okWhen(s.when, tipo));
const visBlocks = (s, tipo) => s.blocks.filter(b => okWhen(b.when, tipo));
function listItems(b, data) { const it = getP(data, [b.key, 'items']); return Array.isArray(it) ? it : []; }
function blockCells(b, data, tipo, obra) {
  const out = []; if (bNA(b, obra)) return out;
  if (b.type === 'form') b.fields.filter(f => fVis(f, tipo, obra, data, b)).forEach(f => out.push({path:[b.key, f.k], f, label:f.l}));
  else if (b.type === 'matrix') b.rows.forEach(r => b.cols.forEach(c => {
    const t = r.t && c.k in r.t ? r.t[c.k] : c.t; if (t === null) return;
    out.push({path:[b.key, r.k, c.k], f:{...c, t}, label:`${r.l} — ${c.l}`});
  }));
  else if (b.type === 'list') listItems(b, data).forEach((it, i) => {
    if (b.cols.every(c => empty(it?.[c.k]))) return;
    b.cols.forEach(c => out.push({path:[b.key, 'items', String(i), c.k], f:c, label:`Fila ${i+1} — ${c.l}`}));
  });
  return out;
}
const scopeData = (b, h, e) => b.scope === 'h' ? h.data : e.data;
function sectionStats(s, h, e) {
  const tipo = tipoOf(e); let tot = 0, ok = 0, missing = [];
  visBlocks(s, tipo).forEach(b => { if (!b.key) return;
    const d = scopeData(b, h, e);
    blockCells(b, d, tipo, obraOf(e)).forEach(c => { tot++; if (!empty(getP(d, c.path))) ok++; else missing.push({...c, b}); });
  });
  return {tot, ok, missing};
}
function equipProgress(h, e) {
  let tot = 0, ok = 0; visSections(tipoOf(e)).forEach(s => { const x = sectionStats(s, h, e); tot += x.tot; ok += x.ok; });
  return tot ? Math.round(ok / tot * 100) : 0;
}

/* ============ RENDER DE CAMPOS ============ */
function inputHtml(c, val, scope, extra = '') {
  const f = c.f, p = esc(c.path.join('|')), base = `data-scope="${scope}" data-path="${p}" data-t="${f.t}" ${extra}`;
  const v = val ?? '';
  if (f.t === 'yn' || f.t === 'sel') {
    const opts = f.t === 'yn' ? YN : f.o;
    return `<select ${base}><option value="">—</option>${opts.map(o => `<option${o === v ? ' selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
  }
  if (f.t === 'ta') return `<textarea ${base}>${esc(v)}</textarea>`;
  const type = f.t === 'd' ? 'date' : f.t === 'n' ? 'number' : 'text';
  const ro = f.ro ? ' readonly tabindex="-1" class="ro" title="Fecha automática (día de alta, para trazabilidad)"' : '';
  const mm = f.t === 'n' ? ` step="any"${f.min != null ? ` min="${f.min}"` : ''}${f.max != null ? ` max="${f.max}"` : ''}` : '';
  return `<input type="${type}"${mm} value="${esc(v)}" ${base}${ro} autocomplete="off">`;
}
const obsHtml = (b, d, scope) => b.obs ? `<div class="full" style="margin-top:12px"><label class="f">${esc(b.obs)}${b.obsHint ? ` <span style="opacity:.85">${esc(b.obsHint)}</span>` : ''}</label>${inputHtml({path:[b.key,'observaciones'],f:{t:'ta'}}, getP(d,[b.key,'observaciones']), scope)}</div>` : '';
const bHead = b => (b.id || b.title) ? `<h3>${b.id ? `<span class="num">${b.id}</span>` : ''}${esc(b.title || '')}</h3>` : '';

function blockHtml(b, h, e) {
  const tipo = tipoOf(e), obra = obraOf(e), d = b.scope ? scopeData(b, h, e) : null;
  let body = '';
  if (bNA(b, obra)) return `<section class="blk">${bHead(b)}<p class="sub">${NO_NUEVA}.</p></section>`;
  if (b.type === 'form') {
    const hid = b.fields.filter(f => okWhen(f.when, tipo) && !fVis(f, tipo, obra, d, b));
    const msgs = [...new Set(hid.map(f => f.na).filter(Boolean))];
    body = msgs.map(m => `<p class="sub">${esc(m)}: ${hid.filter(f => f.na === m).map(f => esc(f.l)).join('; ')}.</p>`).join('') + `<div class="grid">${b.fields.filter(f => fVis(f, tipo, obra, d, b)).map(f => `<div><label class="f">${esc(f.l)}</label>${inputHtml({path:[b.key,f.k],f}, getP(d,[b.key,f.k]), b.scope)}</div>`).join('')}</div>${obsHtml(b, d, b.scope)}`;
  } else if (b.type === 'matrix') {
    body = `<div class="tw"><table><thead><tr><th></th>${b.cols.map(c => `<th>${esc(c.l)}</th>`).join('')}</tr></thead><tbody>${b.rows.map((r, ri) => `${r.grp && (ri === 0 || b.rows[ri-1].grp !== r.grp) ? `<tr><th colspan="${b.cols.length + 1}" style="background:var(--soft);color:var(--pri)">${esc(r.grp)}</th></tr>` : ''}<tr><th class="rh">${esc(r.l)}</th>${b.cols.map(c => {
      const t = r.t && c.k in r.t ? r.t[c.k] : c.t; if (t === null) return '<td class="na"></td>';
      return `<td>${inputHtml({path:[b.key,r.k,c.k],f:{...c,t}}, getP(d,[b.key,r.k,c.k]), b.scope)}</td>`; }).join('')}</tr>`).join('')}</tbody></table></div>${obsHtml(b, d, b.scope)}`;
  } else if (b.type === 'list') {
    const items = listItems(b, d), n = Math.max(items.length, b.min || 0);
    body = `<div class="tw"><table><thead><tr><th>#</th>${b.cols.map(c => `<th>${esc(c.l)}</th>`).join('')}<th></th></tr></thead><tbody>${Array.from({length:n}, (_, i) => `<tr><th>${i+1}</th>${b.cols.map(c => `<td>${inputHtml({path:[b.key,'items',String(i),c.k],f:c}, items[i]?.[c.k], b.scope)}</td>`).join('')}<td><button class="sm danger" data-act="delrow" data-key="${b.key}" data-i="${i}" title="Quitar fila">✕</button></td></tr>`).join('')}</tbody></table></div><div style="margin-top:8px"><button class="sm" data-act="addrow" data-key="${b.key}">+ Agregar fila</button> <span class="muted" style="font-size:13px">Las filas vacías se ignoran.</span></div>`;
  } else if (b.type === 'files') {
    body = `<div class="files" data-kind="${b.kind}"><input type="file" data-act="upload" data-kind="${b.kind}" ${b.kind === 'imagen' ? 'accept="image/*" ' : ''}multiple><ul data-list="${b.kind}"><li class="muted">Cargando…</li></ul></div>`;
  }
  return `<section class="blk">${bHead(b)}${body}</section>`;
}

