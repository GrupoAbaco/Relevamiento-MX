}
const defQ = () => ({f:{tipo:'', obra:'', estado:'', carga:'', entidad:''}, conds:[], mode:'nocumplen', comb:'alguna', incND:false, nivel:'equipos', hq:'algun', cols:[]});
function popRows(q) {
