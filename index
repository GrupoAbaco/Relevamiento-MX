    head = ['Hospital', 'Entidad', 'Municipio', 'Carga', 'Equipos (total)', 'Equipos alcanzados', ...eh, ...extra.map(c => c.label)];
    rows = [...by.values()].filter(a => q.hq === 'todos' ? a.xs.every(x => x.ok) : a.xs.some(x => x.ok)).map(a => {
