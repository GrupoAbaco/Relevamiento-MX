  cv.onpointermove = e => { if (!down) return; const [x, y] = pos(e); cx.lineTo(x, y); cx.stroke(); drawn = true; };
  cv.onpointerup = () => { down = false; };
  $('#clr').onclick = () => { cx.clearRect(0, 0, cv.width, cv.height); drawn = false; };
  $('#dlg').querySelectorAll('[name=fm]').forEach(r => r.onchange = () => { const d = $('#dlg').querySelector('[name=fm]:checked').value === 'digital'; $('#fd').hidden = !d; $('#fi').hidden = d; });
  $('#cx').onclick = closeModal;
  $('#okf').onclick = async () => {
    const modo = $('#dlg').querySelector('[name=fm]:checked').value, er = m => { $('#fe').textContent = m; $('#fe').hidden = false; };
    if (modo === 'digital') { if (!$('#fn').value.trim()) return er('Indique el nombre del firmante.'); if (!drawn) return er('Dibuje su firma en el recuadro.'); if (!$('#decl').checked) return er('Debe aceptar la declaración.'); }
    $('#okf').disabled = true;
    const firma = {modo, nombre:modo === 'digital' ? $('#fn').value.trim() : c.empresa?.resp_nombre, mail:c.empresa?.resp_mail || '', fecha:new Date().toISOString(), por:S.user?.email || '', imagen:modo === 'digital' ? cv.toDataURL('image/png') : null};
    c.total = T.total; firma.hash = await sha256(JSON.stringify({e:c.empresa, h:c.hospital, q:c.equipos, d:c.data, t:c.total, f:firma.fecha}));
    try { await DB.updateCotizacion(c.id, {data:c.data, total:c.total, estado:'firmada', firma}); closeModal(); location.hash = '#/cot/' + c.id; await route(); if (modo === 'impresa') { const c2 = await DB.getCotizacion(c.id); printCot(c2); } }
    catch (e) { $('#okf').disabled = false; er(e.message); }
  };
}

/* ---------- Presentación imprimible ---------- */
function cotPrintHtml(c) {
  const T = cotTotals(c), m = c.data.moneda || '$', f = c.firma, e = c.empresa || {}, bib = C.bib || {secs:[]};
  const eq = (c.equipos || []).map(x => `${x.tipo} · Obra ${x.obra}`).join('  |  ');
  const head = `<div class="cph"><div class="t1">${esc(e.nombre_fantasia || e.razon_social)}${e.nombre_fantasia ? `<span> · ${esc(e.razon_social)}</span>` : ''}</div><div><strong>Hospital:</strong> ${esc(c.hospital?.nombre)}</div><div><strong>Equipos:</strong> ${esc(eq)}</div></div>`;
  const foot = `<div class="cpf"><div class="fl"><div><strong>Responsable técnico:</strong> ${esc(f?.nombre || e.resp_nombre || '')}</div><div>${esc([e.resp_mail, e.resp_tel].filter(Boolean).join(' · '))}</div>${f ? '' : '<div class="bd">BORRADOR · sin validez hasta su firma</div>'}</div><div class="fr">Firma<div class="sgn">${f?.imagen ? `<img src="${f.imagen}" alt="">` : ''}</div></div></div>`;
  const live = T.secs.filter(s => s.sub > 0);
  const resumen = `<h3 class="ct">RESUMEN</h3><table class="cpd rs"><tbody>${live.map(s => `<tr><td>${esc(s.n)}</td><td class="r">${money(s.sub, m)}</td></tr>`).join('')}<tr class="b"><td>SUBTOTAL</td><td class="r">${money(T.subtotal, m)}</td></tr><tr><td>IVA ${num(c.data.iva)}%</td><td class="r">${money(T.iva, m)}</td></tr><tr class="b g"><td>TOTAL</td><td class="r">${money(T.total, m)}</td></tr></tbody></table>`;
  const det = live.map(s => { const sec = bib.secs.find(x => x.nombre === s.n), pre = sec?.prefijo || s.n.replace(/[^A-ZÁÉÍÓÚÑ]/g, '').slice(0, 3);
    let k = 0, last = '\u0000', rows = '';
    c.data.items.filter(i => i.seccion === s.n && applied(i)).forEach(i => { const g = i.subseccion || ''; if (g !== last) { if (g) rows += `<tr class="sg"><td colspan="6">${esc(g)}</td></tr>`; last = g; } k++;
      rows += `<tr><td>${esc(pre)}-${String(k).padStart(2, '0')}</td><td class="cn">${esc(i.concepto)}</td><td class="c">${esc(i.unidad)}</td><td class="r">${r2(num(i.cant)).toLocaleString('es-AR', {minimumFractionDigits:2})}</td><td class="r">${money(num(i.pu), m)}</td><td class="r">${money(lineTot(i), m)}</td></tr>`; });
    return `<table class="cpd"><colgroup><col style="width:11%"><col style="width:45%"><col style="width:8%"><col style="width:10%"><col style="width:13%"><col style="width:13%"></colgroup><thead><tr><th colspan="6" class="sh">${esc(s.n)}</th></tr><tr><th>Clave</th><th>Concepto</th><th>Unidad</th><th>Cantidad</th><th>P. Unitario</th><th>Total</th></tr></thead><tbody>${rows}<tr class="b"><td colspan="5" class="r">${esc(s.n)}</td><td class="r">${money(s.sub, m)}</td></tr></tbody></table>`; }).join('');
  return `<div class="cp">${head}${foot}<table class="cpt"><thead><tr><td><div class="cps h"></div></td></tr></thead><tfoot><tr><td><div class="cps f"></div></td></tr></tfoot><tbody><tr><td><div class="ctl"><strong>COTIZACIÓN · CATÁLOGO DE CONCEPTOS</strong><span>N° ${shortId(c.id)} · Fecha: ${new Date(f?.fecha || c.data.fecha || Date.now()).toLocaleDateString('es-AR')}</span></div>${resumen}<h3 class="ct" style="break-before:page">DETALLE POR SECCIÓN</h3>${det}</td></tr></tbody></table></div>`;
}
async function printCot(c) { if (!C.bib) { try { C.bib = await DB.listBiblio(); } catch (e) {} } await printHtml(cotPrintHtml(c), '@page{size:A4;margin:0}'); }
async function attachScan(c) {
  const inp = document.createElement('input'); inp.type = 'file'; inp.accept = 'application/pdf,image/*';
  inp.onchange = async () => { const f = inp.files[0]; if (!f) return; if (f.size > 25 * 1024 * 1024) return alert('Supera 25 MB.'); try { await DB.adjuntarEscaneo(c.id, f); await route(); } catch (e) { alert(e.message); } };
  inp.click();
}

/* ---------- Dirección de módulo ---------- */
async function viewCot(arg) {
  if (!arg) return viewCotList();
  if (arg === 'nueva') return viewCotNueva();
  return viewCotEdit(arg);
}

/* ---------- Informes de cotizaciones (dueño) ---------- */
Object.assign(I, {cots:[], cv:'lst', csel:new Set(), itSel:[], hosSel:'', incBor:false, itq:''});
const cLabel = c => `${c.empresa?.nombre_fantasia || c.empresa?.razon_social || '?'} · ${c.hospital?.nombre || ''} · ${money(c.total, c.data?.moneda)}${c.estado === 'borrador' ? ' (borrador)' : ''}`;
function cmpTables(qs) {
  if (!qs.length) return {html:'<p class="muted">Seleccione cotizaciones.</p>', csv:null};
  const head = qs.map(c => `${c.empresa?.nombre_fantasia || c.empresa?.razon_social} / ${c.hospital?.nombre}`);
  const T = qs.map(cotTotals), names = [];
  T.forEach(t => t.secs.forEach(s => { if (s.sub > 0 && !names.includes(s.n)) names.push(s.n); }));
  const minmax = arr => { const v = arr.filter(x => x > 0); return [Math.min(...v), Math.max(...v)]; };
  const secRows = names.map(n => { const vals = T.map(t => t.secs.find(s => s.n === n)?.sub || 0), [lo, hi] = minmax(vals);
    return `<tr><td>${esc(n)}</td>${vals.map(v => `<td class="r ${v > 0 && v === lo && lo !== hi ? 'okc' : v > 0 && v === hi && lo !== hi ? 'bad' : ''}">${v ? money(v, qs[0].data.moneda) : '—'}</td>`).join('')}</tr>`; }).join('');
  const tot = T.map(t => t.subtotal), lo = Math.min(...tot.filter(x => x > 0), Infinity);
  const sTab = `<div class="tw"><table><thead><tr><th>Sección (subtotal sin IVA)</th>${head.map(h => `<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${secRows}<tr><th>Subtotal</th>${tot.map(v => `<th class="r">${money(v, qs[0].data.moneda)}</th>`).join('')}</tr><tr><td>Diferencia vs. la más baja</td>${tot.map(v => `<td class="r">${isFinite(lo) && lo > 0 ? (v === lo ? '—' : '+' + r2((v / lo - 1) * 100) + '%') : ''}</td>`).join('')}</tr><tr><th>Total con IVA</th>${T.map(t => `<th class="r">${money(t.total, qs[0].data.moneda)}</th>`).join('')}</tr></tbody></table></div>`;
  // ítems
  const keyOf = i => i.lib_id || norm(i.concepto), rows = new Map();
  qs.forEach((c, qi) => c.data.items.filter(applied).forEach(i => { const k = i.seccion + '|' + keyOf(i); const r = rows.get(k) || {sec:i.seccion, con:i.concepto, un:i.unidad, v:Array(qs.length).fill(null)}; r.v[qi] = i; rows.set(k, r); }));
  const list = [...rows.values()].sort((a, b) => names.indexOf(a.sec) - names.indexOf(b.sec)); let ls = '', it = '';
  const csv = {head:['Sección', 'Ítem', 'Unidad', ...qs.flatMap((c, i) => [head[i] + ' · cantidad', head[i] + ' · P.U.', head[i] + ' · total'])], rows:[]};
  list.forEach(r => { if (r.sec !== ls) { it += `<tr class="sg"><td colspan="${2 + qs.length}">${esc(r.sec)}</td></tr>`; ls = r.sec; }
    const pus = r.v.map(x => x ? num(x.pu) : 0), [plo, phi] = minmax(pus);
    it += `<tr><td class="cn">${esc(r.con.slice(0, 140))}${r.con.length > 140 ? '…' : ''}</td><td>${esc(r.un)}</td>${r.v.map((x, i) => x ? `<td class="r ${pus[i] === plo && plo !== phi ? 'okc' : pus[i] === phi && plo !== phi ? 'bad' : ''}">${r2(num(x.cant))} × ${money(num(x.pu), qs[0].data.moneda)}<br><small>${money(lineTot(x), qs[0].data.moneda)}</small></td>` : '<td class="r muted">—</td>').join('')}</tr>`;
    csv.rows.push([{t:r.sec}, {t:r.con}, {t:r.un}, ...r.v.flatMap(x => x ? [{t:String(num(x.cant))}, {t:String(num(x.pu))}, {t:String(lineTot(x))}] : [{t:''}, {t:''}, {t:''}])]); });
  const iTab = `<h3 style="margin-top:16px">Ítems cotizados (precio unitario: <span class="okc">menor</span> / <span class="bad">mayor</span>)</h3><div class="tw"><table><thead><tr><th>Ítem</th><th>Unidad</th>${head.map(h => `<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${it || '<tr><td colspan="9" class="muted">Sin ítems.</td></tr>'}</tbody></table></div>`;
  return {html:sTab + iTab, csv};
}
function viewCots() {
  const subs = [['lst', 'Listado'], ['cmp', 'Comparar cotizaciones'], ['pu', 'Precio unitario por ítem'], ['hos', 'Análisis por hospital']];
  const cots = I.cots.filter(c => I.incBor || c.estado === 'firmada').sort((a, b) => String(b.updated_at).localeCompare(String(a.updated_at)));
  let body = '';
  if (I.cv === 'lst') body = `<div class="tw"><table><thead><tr><th>N°</th><th>Empresa</th><th>Cargada por</th><th>Hospital</th><th>Equipos</th><th>Estado</th><th>Total</th><th>Fecha</th><th></th></tr></thead><tbody>${cots.map(c => `<tr><td>${shortId(c.id)}</td><td>${esc(c.empresa?.nombre_fantasia || c.empresa?.razon_social)}</td><td>${esc(c.created_email || '')}</td><td>${esc(c.hospital?.nombre)}</td><td>${esc((c.equipos || []).map(e => e.tipo + '·' + e.obra).join('; '))}</td><td><span class="chip ${c.estado === 'firmada' ? 'ok' : 'draft'}">${c.estado === 'firmada' ? 'Firmada' : 'Borrador'}</span></td><td class="r">${money(c.total, c.data?.moneda)}</td><td>${fmtDT(c.firma?.fecha || c.updated_at)}</td><td><a href="#/cot/${c.id}">Ver</a></td></tr>`).join('') || '<tr><td colspan="9" class="muted">Sin cotizaciones.</td></tr>'}</tbody></table></div>`;
  if (I.cv === 'cmp') { const qs = cots.filter(c => I.csel.has(c.id)); const t = cmpTables(qs);
    body = `<div class="card"><strong>Elija 2 o más cotizaciones</strong>${cots.map(c => `<label style="display:flex;gap:8px;align-items:center;margin:4px 0"><input type="checkbox" data-cs="${c.id}" style="width:auto"${I.csel.has(c.id) ? ' checked' : ''}> ${esc(cLabel(c))}</label>`).join('') || '<p class="muted">Sin cotizaciones.</p>'}</div>${t.html}${t.csv ? '<div class="row" style="margin-top:10px"><button id="csvc">Exportar CSV</button></div>' : ''}`; I._csv = t.csv; }
  if (I.cv === 'pu') {
    const all = (I.bib?.items || []), q = norm(I.itq), cand = q.length >= 2 ? all.filter(i => norm(i.seccion + ' ' + i.concepto).includes(q)).slice(0, 25) : [];
    const sel = I.itSel.map(id => all.find(i => i.id === id)).filter(Boolean);
    body = `<div class="card"><label class="f">Buscar ítem de la planilla base</label><input id="itq" value="${esc(I.itq)}" placeholder="Ej.: cable 2/0, interruptor 3x250, tablaroca…">${cand.map(i => `<div class="item" data-ia="${i.id}"><div><strong>${esc(i.clave)}</strong> <span class="muted">${esc(i.seccion)} · ${esc(i.unidad)}</span><div style="font-size:13px">${esc(i.concepto.slice(0, 160))}</div></div><span class="muted">+</span></div>`).join('')}
      ${sel.length ? `<p style="margin-top:10px"><strong>Ítems en análisis:</strong> ${sel.map(i => `<span class="chip">${esc(i.clave)} ${esc(i.concepto.slice(0, 40))}… <a href="#" data-ir="${i.id}">✕</a></span>`).join(' ')}</p>` : ''}</div>
    ${sel.map(it => { const rows = cots.flatMap(c => c.data.items.filter(x => x.lib_id === it.id && applied(x)).map(x => ({c, x}))).sort((a, b) => num(a.x.pu) - num(b.x.pu)); const pus = rows.map(r => num(r.x.pu)).sort((a, b) => a - b); const med = pus.length ? (pus.length % 2 ? pus[(pus.length - 1) / 2] : (pus[pus.length / 2 - 1] + pus[pus.length / 2]) / 2) : 0, mx = Math.max(1, ...pus);
      return `<div class="card"><h3>${esc(it.clave)} · ${esc(it.seccion)} <span class="muted" style="font-weight:400">(${esc(it.unidad)})</span></h3><p class="sub">${esc(it.concepto)}</p>${rows.length ? `<p><strong>${rows.length}</strong> cotización(es) · mínimo <b>${money(pus[0])}</b> · máximo <b>${money(pus[pus.length - 1])}</b> · promedio <b>${money(pus.reduce((s, v) => s + v, 0) / pus.length)}</b> · mediana <b>${money(med)}</b></p>${rows.map(r => `<div class="br" style="grid-template-columns:240px 1fr 110px"><span title="${esc(cLabel(r.c))}">${esc((r.c.empresa?.nombre_fantasia || r.c.empresa?.razon_social) + ' / ' + r.c.hospital?.nombre).slice(0, 44)}</span><span class="bar2"><i class="c1" style="width:${num(r.x.pu) / mx * 100}%"></i></span><span class="bv">${money(num(r.x.pu), r.c.data.moneda)}</span></div>`).join('')}` : '<p class="muted">Ninguna cotización aplicó este ítem.</p>'}</div>`; }).join('')}`;
  }
  if (I.cv === 'hos') {
    const hs = [...new Map(I.cots.map(c => [c.hospital?.id || c.hospital?.nombre, c.hospital?.nombre])).entries()].sort((a, b) => String(a[1]).localeCompare(String(b[1])));
    const qs = cots.filter(c => (c.hospital?.id || c.hospital?.nombre) === I.hosSel); const t = cmpTables(qs);
    body = `<div class="card"><label class="f">Hospital</label><select id="hsel" style="max-width:420px"><option value="">—</option>${hs.map(([k, n]) => `<option value="${esc(k)}"${k === I.hosSel ? ' selected' : ''}>${esc(n)}</option>`).join('')}</select></div>${I.hosSel ? `<div class="card"><strong>${qs.length} cotización(es)</strong>${qs.map(c => `<div>${esc(cLabel(c))} — ${esc((c.equipos || []).map(e => e.tipo + '·' + e.obra).join('; '))}</div>`).join('')}</div>${t.html}${t.csv ? '<div class="row" style="margin-top:10px"><button id="csvc">Exportar CSV</button></div>' : ''}` : ''}`; I._csv = t.csv;
  }
  return `<div class="row" style="margin-bottom:10px"><div class="itabs">${subs.map(([k, l]) => `<button class="tab${I.cv === k ? ' on' : ''}" data-cv="${k}">${l}</button>`).join('')}</div><span class="sp"></span><label style="display:flex;gap:6px;align-items:center"><input type="checkbox" id="incb" style="width:auto"${I.incBor ? ' checked' : ''}> incluir borradores</label></div>${body}`;
}
function bindCots(paint) {
  const B = $('#ibody');
  B.querySelectorAll('[data-cv]').forEach(b => b.onclick = () => { I.cv = b.dataset.cv; paint(); });
  $('#incb').onchange = e => { I.incBor = e.target.checked; paint(); };
  B.querySelectorAll('[data-cs]').forEach(i => i.onchange = () => { i.checked ? I.csel.add(i.dataset.cs) : I.csel.delete(i.dataset.cs); paint(); });
  $('#csvc')?.addEventListener('click', () => downloadCsv(I._csv, 'comparacion_cotizaciones_' + today()));
  $('#hsel')?.addEventListener('change', e => { I.hosSel = e.target.value; paint(); });
  const q = $('#itq'); if (q) { q.oninput = () => { I.itq = q.value; const p = q.selectionStart; paint(); const n = $('#itq'); n.focus(); n.setSelectionRange(p, p); }; }
  B.querySelectorAll('[data-ia]').forEach(el => el.onclick = () => { if (!I.itSel.includes(el.dataset.ia)) I.itSel.push(el.dataset.ia); I.itq = ''; paint(); });
  B.querySelectorAll('[data-ir]').forEach(el => el.onclick = ev => { ev.preventDefault(); I.itSel = I.itSel.filter(x => x !== el.dataset.ir); paint(); });
}

